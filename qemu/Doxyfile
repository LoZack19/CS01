# Doxyfile — QEMU TPM 2.0 Peripheral Documentation
#
# Generate with:   cd qemu && doxygen Doxyfile
# Output:          docs/doxygen/html/index.html
#
# Only the project-specific TPM files are documented here, not the
# entire QEMU tree.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "QEMU TPM 2.0 Peripheral (S32K358)"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Simulation peripheral for the S32K358 TPM 2.0 device model"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = hw/misc/s32k358_tpm.c          \
                         hw/misc/tpm_cmds.c             \
                         hw/misc/tpm_load.c             \
                         hw/misc/tpm_crypt.c            \
                         hw/misc/tpm_marshal.c          \
                         hw/misc/tpm_marshal_tpm.c      \
                         hw/misc/tpm_auth.c             \
                         hw/misc/tpm_object.c           \
                         hw/misc/tpm_drbg.c             \
                         hw/misc/tpm_hierarchy.c        \
                         hw/misc/tpm_ticket.c           \
                         hw/misc/tpm_support.c          \
                         hw/misc/tpm_util.c             \
                         hw/misc/NvStorage.c            \
                         hw/misc/tpm_state_machine.c    \
                         include/hw/misc/s32k358_tpm.h  \
                         hw/misc/tpm_crypt.h            \
                         include/hw/misc/tpm_create_primary.h  \
                         include/hw/misc/tpm2_spec_protocol.h  \
                         README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = NO
EXCLUDE                =
EXCLUDE_PATTERNS       =
USE_MDFILE_AS_MAINPAGE = README.md
INPUT_ENCODING         = UTF-8

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
JAVADOC_AUTOBRIEF      = YES

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = NO

#---------------------------------------------------------------------------
# Warning & Progress
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"

#---------------------------------------------------------------------------
# Source Browser
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
SEARCHENGINE           = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250

#---------------------------------------------------------------------------
# LaTeX Output
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
INCLUDE_PATH           = include
PREDEFINED             = \
    __attribute__(x)= \
    __packed=

#---------------------------------------------------------------------------
# Dot / Call Graphs
#---------------------------------------------------------------------------
HAVE_DOT               = YES
CLASS_GRAPH            = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

#---------------------------------------------------------------------------
# Miscellaneous
#---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
SORT_MEMBER_DOCS       = NO
FULL_PATH_NAMES        = NO
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
