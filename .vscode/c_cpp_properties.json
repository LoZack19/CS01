{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/qemu/include",
                "${workspaceFolder}/qemu/build",
                "${workspaceFolder}/qemu",
                "${workspaceFolder}/firmware/include",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_GNU_SOURCE",
                "CONFIG_POSIX"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": "${workspaceFolder}/qemu/build/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/qemu",
                    "${workspaceFolder}/firmware"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}