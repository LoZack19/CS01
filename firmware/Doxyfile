# Doxyfile — TPM 2.0 Firmware Documentation
#
# Generate with:   doxygen Doxyfile
# Output:          docs/doxygen/html/index.html

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "TPM 2.0 Firmware (S32K358)"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Verification firmware for the QEMU TPM 2.0 simulation peripheral"
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = include src README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                = fakeinclude
EXCLUDE_PATTERNS       =
USE_MDFILE_AS_MAINPAGE = README.md
INPUT_ENCODING         = UTF-8

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = NO

#---------------------------------------------------------------------------
# Warning & Progress
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_FORMAT            = "$file:$line: $text"

#---------------------------------------------------------------------------
# Source Browser
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
SEARCHENGINE           = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250

#---------------------------------------------------------------------------
# LaTeX Output
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
INCLUDE_PATH           = include fakeinclude
PREDEFINED             = \
    __attribute__(x)=  \
    ENABLE_TEST_SMOKE=1 \
    ENABLE_TEST_KEY_MGMT=1

#---------------------------------------------------------------------------
# Dot / Call Graphs
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

#---------------------------------------------------------------------------
# Miscellaneous
#---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
SORT_MEMBER_DOCS       = NO
FULL_PATH_NAMES        = NO
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
